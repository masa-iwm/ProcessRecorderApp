<?xml version="1.0" encoding="utf-8"?>
<!--
  取得元は nuget.org と GitHub Packages（masa-iwm）の 2 つ。
  GstSharpBundle* だけを GitHub Packages から取り、それ以外は nuget.org。

  GitHub Packages は public パッケージでも認証必須。資格情報はここに書かない ──
  ローカルは環境変数（ソース key と対で解決される）:
    $env:NuGetPackageSourceCredentials_github = "Username=masa-iwm;Password=$(gh auth token)"
  CI は build.yml が GITHUB_TOKEN で同じ環境変数を組み立てる。

  <clear /> はマシン/ユーザー設定のソースを遮断する ── 手元にだけ登録された
  フィードから同名パッケージが解決されると、CI と手元で別の中身をビルドしうるため。
  packageSourceMapping は「どれをどこから取るか」の正本（複数ソース + パッケージ版の
  集中管理はマッピングが無いと NU1507 を出す。より具体的なパターンが優先される）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/masa-iwm/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="GstSharpBundle*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
