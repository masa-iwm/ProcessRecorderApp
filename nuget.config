<?xml version="1.0" encoding="utf-8"?>
<!--
  取得元は nuget.org 1 つで、復元に認証は要らない（GstSharp.Net* を含め、参照する
  パッケージはすべて nuget.org 発行）。

  <clear /> はマシン/ユーザー設定のソースを遮断する ── 手元にだけ登録された
  フィードから同名パッケージが解決されると、CI と手元で別の中身をビルドしうるため。
  packageSourceMapping は「どれをどこから取るか」の正本（パッケージ版の集中管理は
  マッピングが無いと NU1507 を出す。より具体的なパターンが優先される）。
  GstSharp.Net* を * と別に書いてあるのは、取得元を明示して残すためで、
  解決結果は * のときと同じ。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="GstSharp.Net*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
