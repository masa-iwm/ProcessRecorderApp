<?xml version="1.0" encoding="utf-8"?>
<!--
  UiaTrigger.* だけ GitHub Packages（masa-iwm）から取得する。

  GitHub Packages は**読み取りにも認証が必須**（無認証の index.json は 401）。
  資格情報は環境変数で与える:
    GITHUB_PACKAGES_USER  = GitHub のユーザー名（例: masa-iwm）
    GITHUB_PACKAGES_TOKEN = read:packages スコープの PAT（CI では GITHUB_TOKEN）
  未設定だと github ソースのみ 401 になり、UiaTrigger.* の解決だけが失敗する
  （他のパッケージは nuget.org から通常どおり解決される）。

  UiaTrigger を nuget.org へ公開したら、github の 3 ブロック
  （packageSources の add / packageSourceMapping / packageSourceCredentials）を
  消すだけでよい。

  <clear /> はマシン/ユーザー設定のソースを遮断する ── packageSourceMapping の
  すり抜け（別ソースからの同名パッケージ解決）を防ぐため。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/masa-iwm/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="UiaTrigger.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>
