<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProcessRecorderApp.Components</RootNamespace>

    <!-- LibraryImport（P/Invoke ソース生成）に必要 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <!-- MVVM 実装のために使用 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Win32 P/Invokeのソースジェネレーター（NativeMethods.txtで指定したAPIのみを生成）。MIT License -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ActivityLog.RotationThresholdBytes / FormatLine（internal）の L1 テスト用 -->
    <InternalsVisibleTo Include="ProcessRecorderApp.Tests" />
  </ItemGroup>

</Project>
