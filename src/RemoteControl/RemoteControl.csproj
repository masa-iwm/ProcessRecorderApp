<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProcessRecorderApp.RemoteControl</RootNamespace>
    <AssemblyName>RemoteControl</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web UI の 3 ファイル。**LogicalName を明示して `/` 区切りで固定する** ──
         既定の論理名は RootNamespace とディレクトリ名から作られるので、
         名前空間を変えた日に WebAssets の探し方が黙って壊れる。 -->
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core は共有フレームワークとして参照する。PackageReference ではないので
         Directory.Packages.props（中央パッケージ管理）は不変のままでよい。
         参照をこのプロジェクトに閉じ込めることで、L1 テストホストへ ASP.NET Core が
         降りてこない（テストプロジェクトはこの csproj を参照しない）。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- **Components だけを参照する。** GStreamer.GstSharpNet と ProcessRecorderApp を
         参照しないので、GstControllerViewModel / RecorderControlService を書けば
         コンパイルが止まる。
         ただし Components が Microsoft.WindowsAppSDK を推移的に持ち込むため、
         DispatcherQueue など Microsoft.UI の型は**書けてしまう** ── UI スレッド越境の
         規律（越境は呼び出し側の責務）を守っているのは L1 の
         RemoteControlIsolationTests によるソーステキストの検査である。 -->
    <ProjectReference Include="..\Components\Components.csproj" />
  </ItemGroup>

</Project>
