<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ProcessRecorderApp.GStreamer</RootNamespace>
    <AssemblyName>GStreamer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.json" />
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>
  <!--
    GStreamer ランタイムの同梱（配布形態を「同梱」「非同梱」の2種類にするための切り替え）。

    runtimes/ はサイズが大きいためリポジトリでは追跡しない。
    同梱ビルドを作るときだけ tools/Fetch-GStreamerRuntime.ps1 で展開してから発行する。

    判定に**ディレクトリの存在を使わない**。dotnet publish は発行先を掃除しないため、
    「runtimes/ の空ディレクトリだけが残っている」状態が実際に起こる（実測）。
    ディレクトリで判定すると、その状態で「同梱した」と判定して**中身の無いものを出荷する**。
    本体 DLL そのものを番人にする。
  -->
  <PropertyGroup>
    <!-- RuntimeIdentifiers は win-x64 のみ（src/Directory.Build.props）。
         増やすときはここも合わせること。 -->
    <GStreamerRuntimeSentinel>$(MSBuildProjectDirectory)\runtimes\win-x64\bin\libgstreamer-1.0-0.dll</GStreamerRuntimeSentinel>
    <BundleGStreamerRuntime Condition="'$(BundleGStreamerRuntime)' == '' AND Exists('$(GStreamerRuntimeSentinel)')">true</BundleGStreamerRuntime>
    <BundleGStreamerRuntime Condition="'$(BundleGStreamerRuntime)' == ''">false</BundleGStreamerRuntime>
  </PropertyGroup>

  <!-- 明示的に同梱を指示したのに中身が無ければ落とす。
       黙って非同梱で発行されると、リリース zip が「同梱版」を名乗ったまま空になる。 -->
  <Target Name="VerifyGStreamerRuntimeBundle" BeforeTargets="BeforeBuild"
          Condition="'$(BundleGStreamerRuntime)' == 'true' AND !Exists('$(GStreamerRuntimeSentinel)')">
    <Error Text="BundleGStreamerRuntime=true が指定されましたが $(GStreamerRuntimeSentinel) がありません。先に tools/Fetch-GStreamerRuntime.ps1 を実行してください。" />
  </Target>

  <ItemGroup Condition="'$(BundleGStreamerRuntime)' == 'true'">
    <!--Contentだと、GStreamer/runtimesにもコピーされるのでNoneとする-->
    <None Include="runtimes\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!--
      同梱物のライセンス文。**同梱するときだけ**入れる ── 非同梱版はここに挙げた
      第三者コンポーネントを1つも含まないので、入れると事実と合わなくなる。

      runtimes\** と同じ条件に乗せてあるのが要点。判定は本体 DLL の有無なので、
      「ランタイムは入ったがライセンス文は入らない」状態にはならない。
      中身の過不足は ThirdPartyLicenseTests(L1) と release.yml の照合が見る。
    -->
    <None Include="$(MSBuildThisFileDirectory)..\..\licenses\third-party\**">
      <Link>licenses\third-party\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Components\Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BusMessageThrottle（internal）の L1 テスト用 -->
    <InternalsVisibleTo Include="ProcessRecorderApp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- GstSharp.Net 本体は**直接参照**にする ── 所有権アナライザー（GST0001/GST0002）は
         NuGet の標準どおり直接参照からしか流れない。.App / .Base を足しても
         本体の直接参照を外さないこと。 -->
    <PackageReference Include="GstSharp.Net" />
    <PackageReference Include="GstSharp.Net.App" />
    <PackageReference Include="GstSharp.Net.Base" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
