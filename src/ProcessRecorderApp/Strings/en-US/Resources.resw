  <data name="PropDesc_Rec_CameraControlsLastError" xml:space="preserve">
    <value>Why the camera controls could not be applied (empty when they were).</value>
  </data>
  <data name="PropDesc_Rec_EncodingProperties" xml:space="preserve">
    <value>Encoding properties applied to the recording pipeline.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousRecording" xml:space="preserve">
    <value>Whether to keep a second recording running at all times, cut into files on a fixed interval. The pre-buffer does not apply to it. Takes effect the next time the recorder is initialized.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousFramerate" xml:space="preserve">
    <value>Frame rate for the continuous recording, written as a fraction such as 5/1. Leave it empty to run at the same rate as the event recording. It only takes effect when the source pipeline pins framerate in its caps: changing one branch otherwise drags the whole capture (preview and event recording included) down to that rate, so the override is dropped and the reason is reported. Any other rate also needs the videorate element; the bundled runtime carries it, but a GStreamer installed separately may not.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousResolution" xml:space="preserve">
    <value>Frame size for the continuous recording, such as 1280x720. Leave it empty to keep the size the event recording uses. It only takes effect when the source pipeline pins width and height in its caps: scaling one branch otherwise drags the whole capture (preview and event recording included) down to that size, so the override is dropped and the reason is reported.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousEncodingProperties" xml:space="preserve">
    <value>Encoding properties for the continuous recording. Leave it empty to have an encoder chosen automatically. If you write your own, pin the GOP length: files are only cut on a key frame, so a long GOP delays every cut.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousFilenameTemplate" xml:space="preserve">
    <value>Filename template for the continuous recording. It is expanded again for every file, so {Now} moves with each one; {Segment} is a five-digit counter.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousSegmentSeconds" xml:space="preserve">
    <value>How many seconds one continuous-recording file covers before the next one starts. Between 5 and 86400. The cut lands on the following key frame, so a long GOP makes the file run over.</value>
  </data>
  <data name="PropDesc_Rec_IsContinuousRecording" xml:space="preserve">
    <value>Whether the continuous recording is running right now.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousLastFilename" xml:space="preserve">
    <value>Path of the continuous-recording file being written right now.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousLastError" xml:space="preserve">
    <value>The most recent problem detected on the continuous recording (empty when healthy). It is kept apart from the recorder error so that a fault here never hides the state of the event recording.</value>
  </data>
  <data name="PropDesc_Rec_ActualContinuousEncodingProperties" xml:space="preserve">
    <value>Encoder the continuous recording actually started with.</value>
  </data>
  <data name="PropDesc_Rec_ContinuousSegmentCount" xml:space="preserve">
    <value>How many continuous-recording files have been written since this recorder was initialized.</value>
  </data>
  <data name="PropDesc_Rec_LastFilename" xml:space="preserve">
    <value>Path of the most recently recorded file.</value>
  </data>
  <data name="PropDesc_Rec_IsRecording" xml:space="preserve">
    <value>Whether recording is currently in progress. Toggling starts or stops recording.</value>
  </data>
  <data name="PropDesc_Rec_IsInitialized" xml:space="preserve">
    <value>Whether the recorder pipeline has been initialized.</value>
  </data>
  <data name="PropDesc_Rec_ActualType" xml:space="preserve">
    <value>Capture method actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_Rec_ActualSrcPipeline" xml:space="preserve">
    <value>Source pipeline actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_Rec_ActualEncodingProperties" xml:space="preserve">
    <value>Encoding properties actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_StopFinalizeTimeout" xml:space="preserve">
    <value>Maximum time (ms) to wait for the recording pipeline to drain when stopping. Keep this at or below 50000: the launcher gives up after 60 seconds, so values close to that make stop-recording return a timeout exit code.</value>
  </data>
  <data name="PropDesc_Rec_LastError" xml:space="preserve">
    <value>The most recent problem detected on this recorder (empty when healthy). Cleared when a new recording starts.</value>
  </data>
  <data name="PropDesc_Rec_StartRecording" xml:space="preserve">
    <value>Start recording.</value>
  </data>
  <data name="PropDesc_Rec_StopRecording" xml:space="preserve">
    <value>Stop recording.</value>
  </data>
  <data name="PropDesc_Rec_Initialize" xml:space="preserve">
    <value>Initialize the recorder pipeline.</value>
  </data>
  <data name="PropDesc_ConfirmRecorderRemoval" xml:space="preserve">
    <value>Show a confirmation dialog before removing a recorder.</value>
  </data>
  <data name="PropDesc_FramingGrid" xml:space="preserve">
    <value>Framing guides drawn over the preview: None, Thirds, GoldenRatio, Crosshair or Square. The lines follow the video area, not the whole panel.</value>
  </data>
  <data name="PropDesc_PaneDisplayMode" xml:space="preserve">
    <value>Navigation pane display mode (Top, Left, etc.).</value>
  </data>
  <data name="PropDesc_Recorders" xml:space="preserve">
    <value>List of configured recorders.</value>
  </data>
  <data name="PropCat_Triggers" xml:space="preserve">
    <value>Triggers</value>
  </data>
  <data name="PropDesc_UiaTriggersEnabled" xml:space="preserve">
    <value>Enable the UI Automation triggers that watch other applications' UI. Turning this off stops the monitoring thread entirely: template variables stop updating and no trigger starts or stops recording.</value>
  </data>
  <data name="PropDesc_UiaTriggerList" xml:space="preserve">
    <value>Shows how many trigger definitions there are. Edit them with the "..." button — the text cannot be typed into. Each trigger watches a UI element of another application and fires when its condition is met.</value>
  </data>
  <data name="PropDesc_UiaTriggerAssignments" xml:space="preserve">
    <value>What each trigger does to recording when it fires. Rows follow the trigger list automatically. The fired values are always written to the template variables regardless of this setting.</value>
  </data>
  <data name="PropDesc_Trigger_TriggerId" xml:space="preserve">
    <value>Id of the trigger definition this row belongs to.</value>
  </data>
  <data name="PropDesc_Trigger_Action" xml:space="preserve">
    <value>Recording action performed when the trigger fires.</value>
  </data>
  <data name="PropDesc_Trigger_TargetRecorder" xml:space="preserve">
    <value>Recorder the action applies to. Leave empty to apply it to every recorder.</value>
  </data>
  <data name="TriggerAction_None" xml:space="preserve">
    <value>(none)</value>
  </data>
  <data name="TriggerAction_Start" xml:space="preserve">
    <value>Start recording</value>
  </data>
  <data name="TriggerAction_Stop" xml:space="preserve">
    <value>Stop recording</value>
  </data>
  <data name="TriggerAction_While" xml:space="preserve">
    <value>Record while matching</value>
  </data>
  <data name="TriggerAction_WhileCannotStop" xml:space="preserve">
    <value>{0} (will not stop: turn on "Also notify when it stops matching" for this trigger)</value>
  </data>
  <data name="TriggerList_Count" xml:space="preserve">
    <value>{0} trigger(s) defined</value>
  </data>
  <data name="TriggerTarget_AllRecorders" xml:space="preserve">
    <value>(all recorders)</value>
  </data>

