  <data name="PropDesc_OutputDirectory" xml:space="preserve">
    <value>Folder the recordings are written to. Pick one with the "..." button, or type a path. Leave empty to use the folder the executable is in. A relative path is resolved against that same folder. A recorder whose filename template is an absolute path ignores this setting.</value>
  </data>
  <data name="PropDesc_RecordingRetentionDays" xml:space="preserve">
    <value>Delete .mp4 files under the output folder once they are older than this many days. 0 deletes nothing. Sub-folders are searched too, and a sub-folder is removed when deleting left it empty. Point the output folder at a directory used only for recordings before turning this on — left empty it covers everything under the folder the executable is in.</value>
  </data>
  <data name="PropDesc_RecordingCleanupIntervalHours" xml:space="preserve">
    <value>How often the deletion runs, in hours. It also runs once right after startup, so a long interval still gets a sweep every time the app starts. Values below 1 are treated as 1.</value>
  </data>
  <data name="PropDesc_PreferredEncoder" xml:space="preserve">
    <value>Element factory name of the preferred H.264 encoder (for example x264enc or qsvh264enc). Leave empty to pick automatically from the encoders available on this machine. If the specified element is not available, the automatic order is used instead. The encoder actually used is shown in each recorder's Actual Encoding Properties.</value>
  </data>
  <data name="PropDesc_GstDebug" xml:space="preserve">
    <value>Sets the GST_DEBUG environment variable at startup (not overwritten if already set).</value>
  </data>
  <data name="PropDesc_GstDebugDumpDotDir" xml:space="preserve">
    <value>Sets the GST_DEBUG_DUMP_DOT_DIR environment variable at startup (not overwritten if already set). Relative paths are resolved against the executable directory.</value>
  </data>
  <data name="PropDesc_DebugLogFile" xml:space="preserve">
    <value>File path to save debug log output. Applied immediately on change. Leave empty to disable saving.</value>
  </data>
  <data name="PropDesc_Rec_Name" xml:space="preserve">
    <value>Display name of the recorder.</value>
  </data>
  <data name="PropDesc_Rec_BufferDuration" xml:space="preserve">
    <value>Length of the pre-recording buffer, in milliseconds.</value>
  </data>
  <data name="PropDesc_Rec_FilenameTemplate" xml:space="preserve">
    <value>Template for the output file name. Supports placeholders such as {Now:...} and {Name}.</value>
  </data>
  <data name="PropDesc_Rec_Type" xml:space="preserve">
    <value>Capture method used for recording (System or D3d12).</value>
  </data>
  <data name="PropDesc_Rec_SrcPipeline" xml:space="preserve">
    <value>GStreamer source pipeline description used for capture.</value>
  </data>
  <data name="PropDesc_Rec_EncodingProperties" xml:space="preserve">
    <value>Encoding properties applied to the recording pipeline.</value>
  </data>
  <data name="PropDesc_Rec_LastFilename" xml:space="preserve">
    <value>Path of the most recently recorded file.</value>
  </data>
  <data name="PropDesc_Rec_IsRecording" xml:space="preserve">
    <value>Whether recording is currently in progress. Toggling starts or stops recording.</value>
  </data>
  <data name="PropDesc_Rec_IsInitialized" xml:space="preserve">
    <value>Whether the recorder pipeline has been initialized.</value>
  </data>
  <data name="PropDesc_Rec_ActualType" xml:space="preserve">
    <value>Capture method actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_Rec_ActualSrcPipeline" xml:space="preserve">
    <value>Source pipeline actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_Rec_ActualEncodingProperties" xml:space="preserve">
    <value>Encoding properties actually in use by the running pipeline.</value>
  </data>
  <data name="PropDesc_StopFinalizeTimeout" xml:space="preserve">
    <value>Maximum time (ms) to wait for the recording pipeline to drain when stopping. Keep this at or below 50000: the launcher gives up after 60 seconds, so values close to that make stop-recording return a timeout exit code.</value>
  </data>
  <data name="PropDesc_Rec_LastError" xml:space="preserve">
    <value>The most recent problem detected on this recorder (empty when healthy). Cleared when a new recording starts.</value>
  </data>
  <data name="PropDesc_Rec_StartRecording" xml:space="preserve">
    <value>Start recording.</value>
  </data>
  <data name="PropDesc_Rec_StopRecording" xml:space="preserve">
    <value>Stop recording.</value>
  </data>
  <data name="PropDesc_Rec_Initialize" xml:space="preserve">
    <value>Initialize the recorder pipeline.</value>
  </data>
  <data name="PropDesc_ConfirmRecorderRemoval" xml:space="preserve">
