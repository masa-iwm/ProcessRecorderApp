<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      コンソールサブシステム（Exe）でビルドする。
      GUIサブシステム（WinExe）だと、対話コマンドプロンプトが本プロセスの終了を待たず
      %ERRORLEVEL% で終了コードを取得できないため。
      （トレードオフ：エクスプローラー等のGUIからの起動時にコンソール窓が一瞬表示されるが、
        ランチャーは即終了するため許容。常駐ワーカーは UseShellExecute=true +
        WindowStyle=Hidden で起動されるため表示されない
        ── SingleInstanceManager.Launcher.cs の
        StartResidentWorkerAndWaitForRegistration を参照）
    -->
    <OutputType>Exe</OutputType>
    <RootNamespace>ProcessRecorderApp</RootNamespace>
    <AssemblyName>ProcessRecorderApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exeファイル自体のアイコン（エクスプローラー/タスクバー表示用） -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    <!--
      WinUI3標準のXAML生成Main()を無効化し、Program.cs内で
      単一インスタンス制御用のカスタムMain()を定義する。
      （公式の「アプリインスタンス管理」サンプルと同じ手法）
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- MSIXを使わないアンパッケージ配布。ビルド時に自動でランタイム初期化コードが注入される -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 単一ファイル発行(win-x64-singlefileプロファイル)で埋め込みresources.priの生成に必要 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    
    <!-- Native AOT -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcMaxVectorTBitWidth>512</IlcMaxVectorTBitWidth>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      GstSharpBundle（glib-sharp 層）は GObject → マネージド型のラップに
      Activator.CreateInstance(type, new object[]{ IntPtr }) と属性走査を使う。
      トリミング（TrimMode=full の AOT 発行）でこのメタデータが削られると、
      **ネイティブは正常にロードされたまま ElementFactory.Find の結果を包めず**、
      エンコーダーのプローブが全滅する（実測: AOT 発行物だけ
      gst.encoders available=[] になり E2E が 43 件赤）。
      アセンブリ全体を root して全メンバのメタデータを保持する。
    -->
    <TrimmerRootAssembly Include="GstSharpBundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK.ML">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning">
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <!-- タスクトレイアイコン（WindowManager.IsVisibleInTray等、MainWindowのサイズ変更検知に使用）。MIT License -->
    <PackageReference Include="WinUIEx" />
    <!-- 起動引数（コマンドライン）の解析に使用。MIT License（.NET Foundation / dotnet/command-line-api） -->
    <PackageReference Include="System.CommandLine" />
    <!-- MVVM 実装のために使用 -->
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Variables ペインのキー/値グリッド表示・編集に使用。MIT License -->
    <PackageReference Include="WinUI.TableView" />
    <!-- 別アプリの UIA 変化を録画トリガ・テンプレート変数にする（監視 API と編集 UI）。
         版はルートの Directory.Packages.props。MIT License -->
    <PackageReference Include="UiaTrigger.Core" />
    <PackageReference Include="UiaTrigger.Picker.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- ウィンドウ/トレイアイコンが実行時にファイルとして参照するため、出力/発行先へコピーする
         （既定ではNone扱いでコピーされず、発行版でアイコンが表示されない） -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Log 画面のターミナル表示（xterm.js）の静的ファイル。

    実行時に WebView2 が SetVirtualHostNameToFolderMapping でこのフォルダを
    **ディスク上の実ディレクトリとして**見るため、単一ファイル発行でも
    バンドルへ埋めずルーズに置く（ExcludeFromSingleFile）。

    ライセンス文（MIT）は同じフォルダの vendor\ に置いてある。
    licenses\third-party\ へは入れないこと ── あちらは同梱 GStreamer 専用の台帳で、
    ThirdPartyLicenseTests がディスクと SOURCES.tsv を、release.yml が COMPONENTS.tsv と
    発行物の runtimes\win-x64 を双方向で突き合わせる。xterm.js は同梱・非同梱の
    両方に入るので、あの台帳に載せると必ず赤になる。

    フォルダー名を runtimes にしないこと（release.yml が非同梱発行物に
    runtimes があると throw する）。
  -->
  <ItemGroup>
    <Content Include="Assets\Terminal\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!--
    ライセンス文を配布物に入れる。

    リポジトリの root に置いてあるだけでは配布 zip には入らない
    ── release.yml が固めるのは publish ディレクトリの中身だけだからである。
    この ItemGroup を消すと **配布物からライセンス文が消える**（本体の MIT すら）。

    同梱物（GStreamer）の第三者ライセンス文は、こちらではなく
    GStreamer.GstSharpBundle.csproj 側に書いてある（ランタイム同梱と対にするため）。
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\license.txt" Link="license.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Controls\Controls.csproj" />
    <ProjectReference Include="..\GStreamer.GstSharpBundle\GStreamer.GstSharpBundle.csproj" />
    <ProjectReference Include="..\SingleInstance\SingleInstance.csproj" />
  </ItemGroup>

  <!-- ローカライズ文字列(en-US/ja-JP)。Strings\**\*.resw は既定の PRIResource グロブで自動的に含まれるため、
       明示的な ItemGroup は追加しない(NETSDK1022 の重複エラーとなる)。 -->

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Windows App SDK の .mui を、対応している言語だけに絞る

    **SatelliteResourceLanguages では止まらない。**あれが絞るのは .NET のサテライト
    (*.resources.dll) であり、.mui は Windows App SDK が配る Win32 の MUI リソースだからである。
    放っておくと `App.WinUI` の発行物に en-us / ja-jp 以外の**85 言語ぶん / 3.3MB** が入り、
    en-US と ja-JP しか持たないアプリが**85 言語で使えるように見える**。

    **上流が用意している逃げ道を使う。**
    microsoft.windowsappsdk.base/*/build/Microsoft.WindowsAppSDK.SelfContained.targets の
    AddMicrosoftWindowsAppSDKPayloadFilesFromComponents が、集めた一覧に対して

      <MicrosoftWindowsAppSDKFiles Remove="@(MicrosoftWindowsAppSDKFilesExcluded)"/>

    を掛けている。そこへ入れておけば済む。**None を後から削る形にしないこと** —
    あの一覧は .dll / .winmd / .xbf も運んでおり、後追いで消す形は取りこぼしと行き過ぎの両方を作る。

    **Remove する側を先に列挙してから、残したい言語を差し戻す**形にしてある。
    「残す側を列挙する」形にすると、言語フォルダの命名が変わった日に**黙って全部落ちる**。
    こちらの形なら、変わったときに増えるのは「落とし損ね」であって「消しすぎ」ではない。

    条件は WindowsAppSdkComponentPackages の有無で見る。WinUI を参照しないプロジェクトでは
    この target 自体が何もしない。
  -->
  <Target Name="ExcludeUnsupportedWindowsAppSdkLanguages"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents"
          DependsOnTargets="GetWindowsAppSDKNativePlatform"
          Condition="'@(WindowsAppSdkComponentPackages)' != ''">
    <PropertyGroup>
      <_WinAppSdkNativeMuiRoot>runtimes-framework\win-$(NativePlatform)\native</_WinAppSdkNativeMuiRoot>
    </PropertyGroup>
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded
          Include="%(WindowsAppSdkComponentPackages.Identity)$(_WinAppSdkNativeMuiRoot)\**\*.mui" />
      <!-- 対応している 2 つだけ差し戻す。NeutralLanguage=en-US / サテライトは ja に揃えてある -->
      <MicrosoftWindowsAppSDKFilesExcluded
          Remove="@(MicrosoftWindowsAppSDKFilesExcluded)"
          Condition="'%(RecursiveDir)' == 'en-us\' Or '%(RecursiveDir)' == 'ja-jp\'" />
    </ItemGroup>
  </Target>

  <!-- 同梱 GStreamer ランタイムの複製は GStreamer.GstSharpBundle.csproj の None
       （gstreamer\**、CopyToPublishDirectory 付き）が ProjectReference 経由で運ぶ。
       こちら側に publish 用の細工は要らない。 -->
</Project>
