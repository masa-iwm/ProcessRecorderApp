<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

フレームワーク依存（.NET ランタイム／WinAppSDK を別途要求する）用プロファイル。
TargetFramework はここでは指定しない（src/Directory.Build.props が唯一の定義元。
プロファイル側に書くと SDK 更新のたびに二重管理となり、実在しない Windows SDK を
指したまま発行が失敗する）。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Release\win-x64\publish\framework\</PublishDir>
    <!-- 発行ごとにビルド出力と中間出力を分ける。理由は win-x64-selfcontained.pubxml のコメント。 -->
    <IntermediateOutputPath>obj\Release\publish-framework\</IntermediateOutputPath>
    <OutputPath>bin\Release\publish-framework\</OutputPath>
    <Configuration>Release</Configuration>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>
