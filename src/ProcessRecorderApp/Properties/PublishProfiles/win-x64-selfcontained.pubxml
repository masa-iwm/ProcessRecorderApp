<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

セルフコンテインド（ディレクトリ出力）用プロファイル。AOT・トリミングは行わず
ReadyToRun のみ有効にする。E2E テストはこのプロファイルの発行物に対して実行する。
TargetFramework はここでは指定しない（src/Directory.Build.props が唯一の定義元。
プロファイル側に書くと SDK 更新のたびに二重管理となり、実在しない Windows SDK を
指したまま発行が失敗する）。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishUrl>bin\Release\win-x64\publish\selfcontained\</PublishUrl>
    <PublishDir>bin\Release\win-x64\publish\selfcontained\</PublishDir>
    <!--
      発行ごとにビルド出力と中間出力を分ける。**共有すると発行物が起動しなくなる。**

      src/Directory.Build.props の AppendRuntimeIdentifierToOutputPath=false により、
      RID 無しの `dotnet build`（0 警告のゲート）と RID 付きの発行が
      **同じ bin / obj を使う**。`resources.pri` は OutputPath に生成されるため、
      非自己完結ビルドが作った「フレームワークのリソースを統合していない PRI」
      （ProcessRecorderApp.pri 171KB）で上書きされ、発行がそれをそのまま持っていく:
        XamlParseException: Cannot locate resource from
          'ms-appx:///Microsoft.UI.Xaml/Themes/themeresources.xaml'
      で即死する（正しい PRI は 2.3MB）。**大きさで一目で分かる。**

      bin/obj を消して restore → build → publish の順に辿ると再現する。
      発行先は掃除されないため、前回の正しい PRI が残っているとこの失敗は隠れる。

      **IntermediateOutputPath だけでは足りない**
      ── PRI は obj ではなく OutputPath に出るので、bin を分けないと
      「発行が最新と判定して、直前のソリューションビルドが置いた PRI を配る」形で再発する。
    -->
    <IntermediateOutputPath>obj\Release\publish-selfcontained\</IntermediateOutputPath>
    <OutputPath>bin\Release\publish-selfcontained\</OutputPath>
    <SkipCompilerExecutionIfUpToDate>false</SkipCompilerExecutionIfUpToDate>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
