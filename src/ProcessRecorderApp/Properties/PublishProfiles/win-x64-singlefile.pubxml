<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

単一ファイル出力用プロファイル。
Native AOTと単一ファイルバンドルは併用不可（.NET SDKのGenerateSingleFileBundleが
PublishAot=trueのとき実行されない）ため、このプロファイルではAOTを無効化する。
TargetFramework はここでは指定しない（src/Directory.Build.props が唯一の定義元。
プロファイル側に書くと SDK 更新のたびに二重管理となり、実在しない Windows SDK を
指したまま発行が失敗する）。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Release\win-x64\publish\singlefile\</PublishDir>
    <!-- 発行ごとにビルド出力と中間出力を分ける。理由は win-x64-selfcontained.pubxml のコメント。 -->
    <IntermediateOutputPath>obj\Release\publish-singlefile\</IntermediateOutputPath>
    <OutputPath>bin\Release\publish-singlefile\</OutputPath>
    <Configuration>Release</Configuration>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      WinAppSDKのネイティブDLL(Microsoft.WindowsAppRuntime.dll等)はWinRTアクティブ化時に
      LoadLibraryで「ディスク上の実ファイル」として読み込まれるため、単一ファイルバンドル内に
      埋め込まれたままだと解決できず 0x8007007E (FileNotFoundException) で起動時にクラッシュする。
      これを有効化すると起動時にネイティブDLLが一時ディレクトリへ展開され、その展開先が
      DLL検索パスへ追加されるため、LoadLibraryから解決できるようになる。
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- AOT・トリミングを無効化（単一ファイルバンドルを機能させるため） -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
