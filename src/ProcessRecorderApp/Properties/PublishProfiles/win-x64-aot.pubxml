<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.

Native AOT 発行用プロファイル。
TargetFramework はここでは指定しない（src/Directory.Build.props が唯一の定義元。
プロファイル側に書くと SDK 更新のたびに二重管理となり、実在しない Windows SDK を
指したまま発行が失敗する）。

前提条件: ILCompiler のネイティブリンクに MSVC が要る。加えて、**開発機で
VS Installer のディレクトリが PATH に通っていない場合は**
"%ProgramFiles(x86)%\Microsoft Visual Studio\Installer" を通しておくこと
（GitHub の windows-latest では標準で解決できるので CI では不要 ── .github/workflows/build.yml 参照）。
ILCompiler は findvcvarsall.bat の標準出力の1行目をツールチェーンのパスとして使うが、
その中で呼ばれる vcvarsall.bat が vswhere を PATH 前提で実行するため、通っていないと
「'vswhere.exe' は…認識されていません」がその1行目に紛れ込み、リンカのパスが壊れて
MSB3073（exit 123）になる。bat 自体は exit 0 を返すのでエラーとして検出されない。
例:
  $env:PATH = "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer;$env:PATH"
  dotnet publish src\ProcessRecorderApp -c Release /p:PublishProfile=win-x64-aot
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\Release\win-x64\publish\aot\</PublishDir>
    <!-- 発行ごとにビルド出力と中間出力を分ける。**共有すると発行物が起動しなくなる。**
         理由は win-x64-selfcontained.pubxml の同じ箇所のコメント（PRI が壊れる）。 -->
    <IntermediateOutputPath>obj\Release\publish-aot\</IntermediateOutputPath>
    <OutputPath>bin\Release\publish-aot\</OutputPath>
    <Configuration>Release</Configuration>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>