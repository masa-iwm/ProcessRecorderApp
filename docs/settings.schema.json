{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppSettings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "DataVersion": {
      "type": "integer"
    },
    "WindowWidth": {
      "type": "integer"
    },
    "WindowHeight": {
      "type": "integer"
    },
    "SettingsWidth": {
      "type": "number"
    },
    "ConfirmRecorderRemoval": {
      "type": "boolean"
    },
    "IsPropertyPaneCollapsed": {
      "type": "boolean"
    },
    "FramingGrid": {
      "enum": [
        "None",
        "Thirds",
        "GoldenRatio",
        "Crosshair",
        "Square"
      ]
    },
    "PaneDisplayMode": {
      "enum": [
        "Auto",
        "Left",
        "Top",
        "LeftCompact",
        "LeftMinimal"
      ]
    },
    "GstDebug": {
      "type": "string"
    },
    "GstDebugDumpDotDir": {
      "type": "string"
    },
    "DebugLogFile": {
      "type": "string"
    },
    "LogScrollbackLines": {
      "type": "integer"
    },
    "PreferredH264Encoder": {
      "type": "string"
    },
    "StopFinalizeTimeoutMs": {
      "type": "integer"
    },
    "OutputDirectory": {
      "type": "string"
    },
    "RecordingRetentionDays": {
      "type": "integer"
    },
    "RecordingCleanupIntervalHours": {
      "type": "integer"
    },
    "UiaTriggersEnabled": {
      "type": "boolean"
    },
    "UiaTriggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "DisplayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "Window": {
            "type": "object",
            "properties": {
              "ProcessName": {
                "type": "string"
              },
              "ProcessNameMatch": {
                "enum": [
                  "Ignored",
                  "Preferred",
                  "Required"
                ]
              },
              "ProcessPath": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ProcessPathMatch": {
                "enum": [
                  "Ignored",
                  "Preferred",
                  "Required"
                ]
              },
              "ClassName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ClassNameMatch": {
                "enum": [
                  "Ignored",
                  "Preferred",
                  "Required"
                ]
              },
              "WindowName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "WindowNameMatch": {
                "enum": [
                  "Ignored",
                  "Preferred",
                  "Required"
                ]
              }
            }
          },
          "Locator": {
            "type": "object",
            "properties": {
              "View": {
                "enum": [
                  "Raw",
                  "Control",
                  "Content"
                ]
              },
              "Search": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "AutomationId": {
                    "type": "string"
                  }
                }
              },
              "Steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ControlType": {
                      "type": "integer"
                    },
                    "AutomationId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "Name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ClassName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "SiblingIndex": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "On": {
            "enum": [
              "ElementAppeared",
              "ElementRemoved",
              "PropertyChanged",
              "WhileMatching",
              "StoppedMatching"
            ]
          },
          "Combine": {
            "enum": [
              "All",
              "Any"
            ]
          },
          "Expression": {
            "type": [
              "string",
              "null"
            ]
          },
          "Clauses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "DisplayName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "Window": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "ProcessName": {
                      "type": "string"
                    },
                    "ProcessNameMatch": {
                      "enum": [
                        "Ignored",
                        "Preferred",
                        "Required"
                      ]
                    },
                    "ProcessPath": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ProcessPathMatch": {
                      "enum": [
                        "Ignored",
                        "Preferred",
                        "Required"
                      ]
                    },
                    "ClassName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ClassNameMatch": {
                      "enum": [
                        "Ignored",
                        "Preferred",
                        "Required"
                      ]
                    },
                    "WindowName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "WindowNameMatch": {
                      "enum": [
                        "Ignored",
                        "Preferred",
                        "Required"
                      ]
                    }
                  }
                },
                "Locator": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "View": {
                      "enum": [
                        "Raw",
                        "Control",
                        "Content"
                      ]
                    },
                    "Search": {
                      "$ref": "#/properties/UiaTriggers/items/properties/Locator/properties/Search"
                    },
                    "Steps": {
                      "$ref": "#/properties/UiaTriggers/items/properties/Locator/properties/Steps"
                    }
                  }
                },
                "Watch": {
                  "type": "boolean"
                },
                "Property": {
                  "enum": [
                    "Name",
                    "AutomationId",
                    "ControlType",
                    "BoundingRectangle",
                    "AccessKey",
                    "AcceleratorKey",
                    "HelpText",
                    "IsEnabled",
                    "IsOffscreen",
                    "Value",
                    "RangeValue",
                    "RangeValueMinimum",
                    "RangeValueMaximum",
                    "ClassName",
                    "Custom"
                  ]
                },
                "CustomPropertyId": {
                  "type": "integer"
                },
                "Op": {
                  "enum": [
                    "Always",
                    "Equals",
                    "NotEquals",
                    "Between",
                    "NotBetween",
                    "GreaterThan",
                    "LessThan",
                    "LessOrEqual",
                    "GreaterOrEqual",
                    "RegexMatch",
                    "RegexNotMatch"
                  ]
                },
                "Text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "Value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "Low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "High": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "Tolerance": {
                  "type": "number"
                }
              }
            }
          },
          "MinInterval": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "PollInterval": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(\\d+\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "NotifyOnStoppedMatching": {
            "type": "boolean"
          }
        },
        "required": [
          "Id"
        ]
      }
    },
    "TemplateVariables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "Recorders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "BufferDuration": {
            "type": "integer"
          },
          "FilenameTemplate": {
            "type": "string"
          },
          "Type": {
            "enum": [
              "System",
              "D3d12"
            ]
          },
          "SrcPipeline": {
            "type": [
              "string",
              "null"
            ]
          },
          "EncodingProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "CameraControls": {
            "type": [
              "string",
              "null"
            ]
          },
          "ContinuousRecording": {
            "type": "boolean"
          },
          "ContinuousFramerate": {
            "type": "string"
          },
          "ContinuousResolution": {
            "type": "string"
          },
          "ContinuousEncodingProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "ContinuousFilenameTemplate": {
            "type": "string"
          },
          "ContinuousSegmentSeconds": {
            "type": "integer"
          }
        }
      }
    },
    "UiaTriggerAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "TriggerId": {
            "type": "string"
          },
          "Action": {
            "type": "string"
          },
          "TargetRecorder": {
            "type": "string"
          }
        }
      }
    },
    "IsFirstRun": {
      "type": "boolean"
    }
  }
}